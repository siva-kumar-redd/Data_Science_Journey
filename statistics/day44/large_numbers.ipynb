   "source": [
    "Law of Large Numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6b28c2b9-cc76-4ef9-a768-148bb98693ea",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10 rolls → average: 3.2\n",
      "100 rolls → average: 3.72\n",
      "1000 rolls → average: 3.484\n",
      "10000 rolls → average: 3.5123\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "rolls = np.random.randint(1, 7, 10000)\n",
    "\n",
    "for n in [10, 100, 1000, 10000]:\n",
    "    average = rolls[:n].mean()\n",
    "    print(n, \"rolls → average:\", average)"
   ]
  },
